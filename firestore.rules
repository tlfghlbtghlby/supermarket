rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Debtor Validator
    function isValidDebtor(data) {
      return data.id is string && isValidId(data.id)
        && data.userId is string && isOwner(data.userId)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Transaction Validator
    function isValidTransaction(data) {
      return data.id is string && isValidId(data.id)
        && data.userId is string && isOwner(data.userId)
        && data.debtorId is string && isValidId(data.debtorId)
        && (data.type == 'DEBT' || data.type == 'PAYMENT')
        && (data.amount is number || data.amount is int) && data.amount > 0
        && data.date is string && data.date.size() <= 64
        && data.description is string && data.description.size() <= 500
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('paymentMethod' in data) || (data.paymentMethod in ['CASH', 'TRANSFER', 'CARD', 'OTHER']))
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Store Settings Validator
    function isValidStoreSettings(data) {
      return data.id is string && isValidId(data.id)
        && data.userId is string && isOwner(data.userId)
        && data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 150
        && (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 100))
        && (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200))
        && (!('ownerPasswordCode' in data) || (data.ownerPasswordCode is string && data.ownerPasswordCode.size() <= 100))
        && (!('shopCode' in data) || (data.shopCode is string && data.shopCode.size() <= 50))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && data.currency is string && data.currency.size() <= 20
        && (!('customCurrencyName' in data) || (data.customCurrencyName is string && data.customCurrencyName.size() <= 50))
        && (!('customWhatsAppMessage' in data) || (data.customWhatsAppMessage is string && data.customWhatsAppMessage.size() <= 1000))
        && (!('enableWhatsAppAlerts' in data) || data.enableWhatsAppAlerts is bool)
        && (!('storeWhatsAppPhone' in data) || (data.storeWhatsAppPhone is string && data.storeWhatsAppPhone.size() <= 50))
        && (!('themeMode' in data) || (data.themeMode is string && data.themeMode.size() <= 30))
        && (!('strictCreditLimit' in data) || data.strictCreditLimit is bool)
        && (!('metaWhatsAppEnabled' in data) || data.metaWhatsAppEnabled is bool)
        && (!('metaPhoneNumberId' in data) || (data.metaPhoneNumberId is string && data.metaPhoneNumberId.size() <= 100))
        && (!('metaAccessToken' in data) || (data.metaAccessToken is string && data.metaAccessToken.size() <= 500))
        && (!('metaBusinessAccountId' in data) || (data.metaBusinessAccountId is string && data.metaBusinessAccountId.size() <= 100))
        && (!('telegramBotToken' in data) || (data.telegramBotToken is string && data.telegramBotToken.size() <= 200))
        && (!('telegramBotUsername' in data) || (data.telegramBotUsername is string && data.telegramBotUsername.size() <= 100))
        && (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 100))
        && (!('telegramOwnerName' in data) || (data.telegramOwnerName is string && data.telegramOwnerName.size() <= 100))
        && (!('enableTelegramAlerts' in data) || data.enableTelegramAlerts is bool)
        && (!('enableDailyMidnightReport' in data) || data.enableDailyMidnightReport is bool)
        && (!('lastDailyMidnightReportDate' in data) || (data.lastDailyMidnightReportDate is string && data.lastDailyMidnightReportDate.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Profile Validator
    function isValidUserProfile(data) {
      return data.uid is string && isOwner(data.uid)
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // Connection Health Test
    match /test/connection {
      allow get: if isSignedIn();
    }

    // Debtors Collection
    match /debtors/{debtorId} {
      allow get: if isSignedIn() && isValidId(debtorId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(debtorId) 
                    && incoming().id == debtorId 
                    && incoming().userId == request.auth.uid 
                    && isValidDebtor(incoming());
      allow update: if isSignedIn() && isValidId(debtorId) 
                    && (resource == null || existing().userId == request.auth.uid) 
                    && incoming().userId == request.auth.uid 
                    && incoming().id == debtorId 
                    && isValidDebtor(incoming());
      allow delete: if isSignedIn() && isValidId(debtorId) 
                    && (resource == null || existing().userId == request.auth.uid);
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) 
                    && incoming().id == transactionId 
                    && incoming().userId == request.auth.uid 
                    && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidId(transactionId) 
                    && (resource == null || existing().userId == request.auth.uid) 
                    && incoming().userId == request.auth.uid 
                    && incoming().id == transactionId 
                    && isValidTransaction(incoming());
      allow delete: if isSignedIn() && isValidId(transactionId) 
                    && (resource == null || existing().userId == request.auth.uid);
    }

    // Store Settings Collection
    match /settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId) && (settingId == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid));
      allow list: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(settingId) 
                    && settingId == request.auth.uid
                    && incoming().userId == request.auth.uid 
                    && isValidStoreSettings(incoming());
      allow update: if isSignedIn() && isValidId(settingId) 
                    && settingId == request.auth.uid
                    && incoming().userId == request.auth.uid 
                    && isValidStoreSettings(incoming());
      allow delete: if isSignedIn() && isValidId(settingId) 
                    && settingId == request.auth.uid;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && isValidId(userId) 
                            && userId == request.auth.uid 
                            && incoming().uid == request.auth.uid 
                            && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }
  }
}
